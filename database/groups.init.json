{
  "collection": "groups",
  "permission": "仅管理端可读写",
  "permissionRule": "auth != null && auth.openid == null",
  "indexes": [
    {
      "name": "inviteCode_unique",
      "fields": [
        { "field": "inviteCode", "order": "asc" }
      ],
      "unique": true
    },
    {
      "name": "status",
      "fields": [
        { "field": "status", "order": "asc" }
      ],
      "unique": false
    }
  ],
  "sampleDocs": [
    {
      "_id": "example",
      "_openid": "oYOUR_OPENID_HERE",
      "name": "早起跑步打卡群",
      "description": "每天 7 点前跑步 3 公里",
      "sportTheme": "running",
      "inviteCode": "A1B2C3",
      "ownerOpenid": "oYOUR_OPENID_HERE",
      "memberCount": 1,
      "createTime": { "$date": 1756041600000 },
      "status": "active"
    }
  ],
  "note": "权限选择「仅管理端可读写」，小程序端不直读 groups（含 inviteCode），群列表/群详情全部经云函数读取并校验成员身份，防止邀请码被任意读取。创建 inviteCode 唯一索引（云函数生成时依赖唯一性重试）。"
}
