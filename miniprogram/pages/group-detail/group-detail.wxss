.page {
  padding: 32rpx 32rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-loading {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-sub);
  font-size: 26rpx;
}

.detail-card {
  margin-bottom: 36rpx;
  text-align: center;
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 800;
}

.edit-link {
  position: absolute;
  right: 0;
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-bg);
  border-radius: 14rpx;
  padding: 8rpx 20rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 600rpx;
  padding: 48rpx 40rpx;
  background: #FFFFFF;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  background: #FFF7F0;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.modal-btn {
  flex: 1;
  margin: 0;
  padding: 20rpx 0;
}

.detail-theme {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-bg);
  border-radius: 16rpx;
  padding: 6rpx 20rpx;
}

.detail-desc {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

.invite-row {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
}

.invite-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

.invite-code {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  color: var(--primary);
}

.invite-btn {
  margin: 0;
  padding: 14rpx 44rpx;
  font-size: 28rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.member-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: block;
}

.member-avatar-sk {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
}

.member-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.member-name {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.owner-tag {
  display: inline-block;
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: var(--primary);
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
  vertical-align: middle;
}

.member-remove {
  font-size: 24rpx;
  color: #F5222D;
  padding: 8rpx 20rpx;
  background: #FFF1F0;
  border-radius: 16rpx;
}

.bottom-actions {
  margin-top: 48rpx;
}

.action-btn {
  margin: 0;
  padding: 22rpx 0;
  font-size: 30rpx;
}
