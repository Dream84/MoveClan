.page {
  padding: 32rpx 32rpx 240rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.group-select {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow-light);
}

.group-select-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
}

.group-select-arrow {
  margin-left: 10rpx;
  color: var(--primary);
}

.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 48rpx;
  padding: 8rpx;
  box-shadow: var(--shadow-light);
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-sub);
  border-radius: 40rpx;
}

.tab.active {
  background: linear-gradient(135deg, #FF9A62, #FF6A3D);
  color: #FFFFFF;
  box-shadow: 0 8rpx 16rpx rgba(255, 106, 61, 0.3);
}

.sorts {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.sort-chip {
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
  color: var(--text-sub);
  box-shadow: var(--shadow-light);
}

.sort-chip.active {
  background: var(--primary-bg);
  color: var(--primary);
  font-weight: 600;
}

.rank-item {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-light);
}

.rank-item.me {
  background: #FFF1E0;
  border: 2rpx solid rgba(255, 122, 69, 0.35);
}

.rank-num {
  width: 72rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-sub);
}

.rank-num-sk {
  width: 48rpx;
  height: 32rpx;
  margin: 0 12rpx 0 0;
  flex-shrink: 0;
}

.rank-avatar-sk {
  width: 84rpx;
  height: 84rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-num .medal {
  font-size: 40rpx;
}

.rank-avatar-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: block;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.me-tag {
  display: inline-block;
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: var(--primary);
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
  vertical-align: middle;
}

.rank-sub {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.rank-value {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--primary);
  flex-shrink: 0;
  margin-left: 12rpx;
}

.my-rank-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 112rpx;
  background: linear-gradient(135deg, #FF9A62, #FF6A3D);
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 24rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 32rpx rgba(255, 106, 61, 0.4);
}

.my-rank-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  text-align: right;
  flex-shrink: 1;
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 400;
  opacity: 0.95;
  line-height: 1.4;
}

.goto-btn {
  margin: 40rpx auto 0;
  width: 240rpx;
  text-align: center;
  padding: 20rpx 0;
}
