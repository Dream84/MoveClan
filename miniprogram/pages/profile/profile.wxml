<view class="page">
  <view class="profile-card card">
    <view class="avatar-wrap">
      <image wx:if="{{avatarDisplay}}" class="avatar" src="{{avatarDisplay}}" mode="aspectFill"></image>
      <view wx:else class="avatar avatar-fallback">{{userInfo.nickName ? userInfo.nickName[0] : '跃'}}</view>
    </view>
    <view class="profile-text">
      <view class="profile-name">{{userInfo.nickName || '微信用户'}}</view>
    </view>
    <view class="edit-btn" bindtap="openEdit">编辑资料</view>
  </view>

  <view class="bmi-card">
    <view class="bmi-card-head">
      <view class="bmi-card-title">HEALTH METER · 身体质量指数</view>
      <view class="bmi-card-sub">BMI 环形指标 · 按中国成人标准</view>
    </view>
    <bmi-gauge
      heightCm="{{userInfo.heightCm >= 50 ? userInfo.heightCm : 170}}"
      weightKg="{{userInfo.weightKg >= 20 ? userInfo.weightKg : 50}}"
    />
  </view>

  <view class="stats-card card">
    <view class="stats-grid" wx:if="{{!statsLoaded}}">
      <view class="stats-item">
        <view class="sk-block stats-sk"></view>
        <view class="stats-label">总打卡次数</view>
      </view>
      <view class="stats-item">
        <view class="sk-block stats-sk"></view>
        <view class="stats-label">总卡路里</view>
      </view>
      <view class="stats-item">
        <view class="sk-block stats-sk"></view>
        <view class="stats-label">最高连续天数</view>
      </view>
    </view>
    <view class="stats-grid" wx:else>
      <view class="stats-item">
        <view class="stats-num">{{stats.totalCount}}</view>
        <view class="stats-label">总打卡次数</view>
      </view>
      <view class="stats-item">
        <view class="stats-num">{{stats.totalCalories}}</view>
        <view class="stats-label">总卡路里</view>
      </view>
      <view class="stats-item">
        <view class="stats-num">{{stats.maxStreakDays}}</view>
        <view class="stats-label">最高连续天数</view>
      </view>
    </view>
    <view class="stats-sub">
      <text>本周 {{stats.weekCount}}次 / {{stats.weekCalories}}千卡</text>
      <text>本月 {{stats.monthCount}}次 / {{stats.monthCalories}}千卡</text>
    </view>
  </view>

  <view class="section-title">打卡日历</view>
  <calendar
    year="{{calYear}}"
    month="{{calMonth}}"
    value="{{calValue}}"
    bindmonthchange="onCalMonthChange"
  />

  <view class="section-title">体重趋势</view>
  <view class="trend-card card">
    <view class="trend-toggles">
      <view class="seg {{trendMetric === 'weight' ? 'active' : ''}}" data-metric="weight" bindtap="onMetricChange">体重</view>
      <view class="seg {{trendMetric === 'bmi' ? 'active' : ''}}" data-metric="bmi" bindtap="onMetricChange">BMI</view>
      <view class="seg-divider"></view>
      <view class="seg {{trendPeriod === 'day' ? 'active' : ''}}" data-period="day" bindtap="onPeriodChange">日</view>
      <view class="seg {{trendPeriod === 'week' ? 'active' : ''}}" data-period="week" bindtap="onPeriodChange">周</view>
      <view class="seg {{trendPeriod === 'month' ? 'active' : ''}}" data-period="month" bindtap="onPeriodChange">月</view>
      <view class="seg {{trendPeriod === 'year' ? 'active' : ''}}" data-period="year" bindtap="onPeriodChange">年</view>
    </view>

    <picker mode="date" value="{{trendAnchor}}" end="{{trendPickerEnd}}" fields="{{trendPickerFields}}" bindchange="onAnchorChange">
      <view class="trend-nav">
        <view class="nav-btn" catchtap="onPrevAnchor">‹</view>
        <view class="trend-anchor">{{trendAnchorLabel}}</view>
        <view class="nav-btn {{canNext ? '' : 'disabled'}}" catchtap="onNextAnchor">›</view>
      </view>
    </picker>

    <weight-chart
      records="{{weightRecords}}"
      period="{{trendPeriod}}"
      metric="{{trendMetric}}"
      anchor="{{trendAnchor}}"
      heightCm="{{userInfo.heightCm >= 50 ? userInfo.heightCm : 170}}"
    />
  </view>

  <view class="modal-mask" wx:if="{{showEdit}}" bindtap="closeEdit">
    <view class="modal card" catchtap="noop">
      <view class="modal-title">编辑资料</view>
      <button class="choose-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{editAvatarTemp}}" class="choose-avatar" src="{{editAvatarTemp}}" mode="aspectFill"></image>
        <image wx:elif="{{editAvatarUrl}}" class="choose-avatar" src="{{editAvatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="choose-avatar avatar-fallback">选</view>
        <view class="choose-tip">点击更换头像</view>
      </button>
      <view class="modal-field">
        <text class="modal-label">昵称</text>
        <input class="modal-input" type="nickname" placeholder="请输入昵称" maxlength="30" value="{{editNickName}}" bindinput="onNickInput" />
      </view>
      <view class="modal-field">
        <text class="modal-label">体重</text>
        <input class="modal-input" type="digit" placeholder="如 60" maxlength="5" value="{{editWeight}}" bindinput="onWeightInput" />
        <text class="modal-unit">公斤</text>
      </view>
      <view class="modal-field">
        <text class="modal-label">身高</text>
        <input class="modal-input" type="digit" placeholder="如 170" maxlength="5" value="{{editHeight}}" bindinput="onHeightInput" />
        <text class="modal-unit">厘米</text>
      </view>
      <view class="modal-btns">
        <button class="btn-ghost modal-btn" bindtap="closeEdit">取消</button>
        <button class="btn-primary modal-btn" bindtap="saveProfile">保存</button>
      </view>
    </view>
  </view>
</view>
