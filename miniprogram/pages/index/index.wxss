.page {
  padding: 32rpx 32rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.avatar-wrap {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9A62, #FF6A3D);
  padding: 6rpx;
  box-shadow: var(--shadow-soft);
  box-sizing: border-box;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff;
  display: block;
}

.header-text {
  margin-left: 24rpx;
}

.profile-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}

.profile-tip-text {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.profile-tip-title {
  font-size: 30rpx;
  font-weight: 700;
}

.profile-tip-sub {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.tip-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 14rpx 32rpx;
  font-size: 26rpx;
}

.greeting {
  font-size: 36rpx;
  font-weight: 800;
}

.slogan {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.group-select {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow-light);
}

.group-select-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
}

.group-select-arrow {
  margin-left: 10rpx;
  color: var(--primary);
}

.checkin-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF9A62, #FF6A3D);
  color: #FFFFFF;
  border-radius: 48rpx;
  padding: 40rpx 0;
  margin-bottom: 36rpx;
  box-shadow: 0 16rpx 40rpx rgba(255, 106, 61, 0.4);
  border: none;
}

.checkin-icon {
  font-size: 52rpx;
  margin-right: 16rpx;
}

.checkin-text {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.week-row {
  display: flex;
}

.week-item {
  flex: 1;
  text-align: center;
}

.week-item + .week-item {
  border-left: 1rpx solid var(--border);
}

.week-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--primary);
}

.week-label {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.recent-card {
  margin-top: 28rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: var(--primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.recent-info {
  flex: 1;
  margin-left: 20rpx;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 700;
}

.recent-count {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--primary);
  background: var(--primary-bg);
  border-radius: 12rpx;
  padding: 2rpx 10rpx;
}

.recent-meta {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}

.recent-stats {
  text-align: right;
}

.recent-dur {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
}

.recent-cal {
  display: block;
  font-size: 24rpx;
  color: var(--primary);
  margin-top: 4rpx;
}

.goto-btn {
  margin: 40rpx auto 0;
  width: 240rpx;
  text-align: center;
  padding: 20rpx 0;
}
