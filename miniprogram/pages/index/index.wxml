<view class="page">
  <view class="header">
    <view class="avatar-wrap">
      <image wx:if="{{avatarDisplay}}" class="avatar" src="{{avatarDisplay}}" mode="aspectFill"></image>
      <view wx:else class="avatar avatar-fallback">{{userInfo.nickName ? userInfo.nickName[0] : '跃'}}</view>
    </view>
    <view class="header-text">
      <view class="greeting">{{greeting}}，{{userInfo.nickName || '用户'}}</view>
      <view class="slogan">今天也动起来吧 💪</view>
    </view>
  </view>

  <view class="profile-tip card" wx:if="{{showProfileTip}}">
    <view class="profile-tip-text">
      <view class="profile-tip-title">设置头像昵称</view>
      <view class="profile-tip-sub">一键使用微信昵称和头像作为默认资料</view>
    </view>
    <button class="btn-primary tip-btn" bindtap="useWechatProfile">一键设置</button>
  </view>

  <view class="main-area">
    <picker wx:if="{{groups.length > 1}}" mode="selector" range="{{groups}}" range-key="name" value="{{groupIndex}}" bindchange="onGroupChange">
      <view class="group-select">
        <text class="group-select-name">{{currentGroup.name}}</text>
        <text class="group-select-arrow">▾</text>
      </view>
    </picker>

    <view wx:if="{{!loading && !currentGroup}}" class="empty-tip">
      你还没有加入运动群，加入或创建群组后即可开始打卡
      <view class="btn-ghost goto-btn" bindtap="goGroups">去群组</view>
    </view>

    <block wx:if="{{currentGroup}}">
      <button class="checkin-btn btn-hover" bindtap="goCheckin">
        <text class="checkin-icon">🔥</text>
        <text class="checkin-text">今日打卡</text>
      </button>

      <view class="week-card card">
        <view class="section-title">本周概览</view>
        <view class="week-row" wx:if="{{loading}}">
          <view class="week-item">
            <view class="sk-block week-sk"></view>
            <view class="week-label">打卡次数</view>
          </view>
          <view class="week-item">
            <view class="sk-block week-sk"></view>
            <view class="week-label">千卡</view>
          </view>
          <view class="week-item">
            <view class="sk-block week-sk"></view>
            <view class="week-label">连续天数</view>
          </view>
        </view>
        <view class="week-row" wx:else>
          <view class="week-item">
            <view class="week-num">{{weekStats.weekCount}}</view>
            <view class="week-label">打卡次数</view>
          </view>
          <view class="week-item">
            <view class="week-num">{{weekStats.weekCalories}}</view>
            <view class="week-label">千卡</view>
          </view>
          <view class="week-item">
            <view class="week-num">{{weekStats.streakDays}}</view>
            <view class="week-label">连续天数</view>
          </view>
        </view>
      </view>

      <view class="recent-card card">
        <view class="section-title">最近打卡</view>
        <block wx:if="{{recentLoading && !recentCheckins.length}}">
          <view class="recent-item" wx:for="{{[1, 2, 3]}}" wx:key="*this">
            <view class="sk-circle recent-sk-icon"></view>
            <view class="recent-info">
              <view class="sk-block sk-line"></view>
              <view class="sk-block sk-line-short"></view>
            </view>
          </view>
        </block>
        <view wx:elif="{{!recentLoading && !recentCheckins.length}}" class="empty-tip">还没有打卡记录，快去打第一卡吧</view>
        <block wx:else>
          <view class="recent-item" wx:for="{{recentCheckins}}" wx:key="_id" data-id="{{item._id}}" bindtap="editCheckin">
            <view class="recent-icon">🏃</view>
            <view class="recent-info">
              <view class="recent-title">
                {{item.sportLabel}}
                <text class="recent-count" wx:if="{{item.count > 1}}">x{{item.count}}</text>
              </view>
              <view class="recent-meta">{{item.showTime}}</view>
            </view>
            <view class="recent-stats">
              <text class="recent-dur">{{item.duration}}分钟</text>
              <text class="recent-cal">{{item.calories}}千卡</text>
            </view>
          </view>
        </block>
        <view class="recent-footer">
          <text wx:if="{{recentLoading && recentCheckins.length}}">加载中...</text>
          <text wx:elif="{{recentHasMore}}">上拉加载更多</text>
          <text wx:elif="{{recentCheckins.length > 0}}">没有更多了</text>
        </view>
      </view>
    </block>
  </view>
</view>
