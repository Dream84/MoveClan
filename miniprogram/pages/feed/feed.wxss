.page {
  padding: 32rpx 32rpx 160rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.group-select {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow-light);
}

.group-select-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary);
}

.group-select-arrow {
  margin-left: 10rpx;
  color: var(--primary);
}

.feed-card {
  margin-bottom: 24rpx;
}

.feed-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.feed-avatar-wrap {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.feed-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: block;
}

.feed-avatar-sk {
  width: 84rpx;
  height: 84rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.feed-head-text {
  flex: 1;
  min-width: 0;
}

.feed-name {
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.me-tag {
  display: inline-block;
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: var(--primary);
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
  vertical-align: middle;
}

.feed-date {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.feed-body {
  background: #FFF8F3;
  border-radius: 20rpx;
  padding: 20rpx;
}

.feed-sport {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.feed-sport-sk {
  height: 32rpx;
  margin-top: 24rpx;
}

.feed-img {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
  background: #F0F0F0;
}

.feed-remark {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

.feed-actions {
  display: flex;
  gap: 48rpx;
  padding: 20rpx 0 8rpx;
}

.action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-sub);
}

.action.liked {
  color: #F5222D;
}

.action-icon {
  font-size: 32rpx;
}

.feed-likers {
  display: flex;
  align-items: center;
  padding: 12rpx 0 4rpx;
  flex-wrap: wrap;
}

.liker-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: #F0F0F0;
  flex-shrink: 0;
}

.liker-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF9A62, #FF6A3D);
}

.liker-more {
  font-size: 22rpx;
  color: var(--text-light);
  margin-left: 4rpx;
}

.feed-comments {
  border-top: 1rpx dashed rgba(255, 122, 69, 0.35);
  margin-top: 12rpx;
  padding-top: 16rpx;
}

.comment {
  font-size: 26rpx;
  line-height: 1.7;
  margin-bottom: 6rpx;
}

.cm-name {
  color: var(--accent-blue);
  font-weight: 600;
}

.cm-content {
  color: var(--text-main);
}

.show-all {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 8rpx;
}

.feed-footer {
  text-align: center;
  color: var(--text-light);
  font-size: 24rpx;
  padding: 20rpx 0;
}

.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.98);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #F3F4F6;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.comment-send {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  line-height: 1.4;
  border-radius: 36rpx;
  background: #F0F0F0;
  color: var(--text-light);
  text-align: center;
}

.comment-send.active {
  background: linear-gradient(135deg, #FF9A62, #FF6A3D);
  color: #FFFFFF;
  font-weight: 600;
}

.comment-close {
  font-size: 30rpx;
  color: var(--text-sub);
  padding: 8rpx 4rpx;
  flex-shrink: 0;
}

.goto-btn {
  margin: 40rpx auto 0;
  width: 240rpx;
  text-align: center;
  padding: 20rpx 0;
}
