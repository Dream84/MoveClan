.page {
  min-height: 100vh;
  background: #0b1118;
  padding: 48rpx 40rpx 60rpx;
  box-sizing: border-box;
  color: #eaf2ff;
}

.head {
  margin-bottom: 36rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #3ddc97;
  margin-top: 10rpx;
  font-weight: 600;
}

.desc {
  font-size: 22rpx;
  color: #6b7a90;
  margin-top: 10rpx;
}

.input-card {
  background: #101826;
  border-radius: 24rpx;
  padding: 12rpx 28rpx;
  margin-bottom: 20rpx;
}

.input-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.input-row + .input-row {
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.input-label {
  width: 96rpx;
  font-size: 28rpx;
  color: #8ea0b8;
}

.input {
  flex: 1;
  color: #eaf2ff;
  font-size: 30rpx;
  text-align: right;
}

.input-unit {
  width: 60rpx;
  text-align: right;
  font-size: 24rpx;
  color: #6b7a90;
}

.samples {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.sample {
  padding: 12rpx 26rpx;
  border-radius: 32rpx;
  background: #1a2436;
  color: #8ea0b8;
  font-size: 24rpx;
}

.gauge-card {
  background: #0b1118;
  border-radius: 28rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.5);
}
