.calendar {
  padding: 28rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--primary);
  background: var(--primary-bg);
  border-radius: 50%;
  line-height: 1;
}

.cal-title {
  font-size: 30rpx;
  font-weight: 700;
}

.cal-week {
  display: flex;
  margin-bottom: 8rpx;
}

.cal-week-item {
  flex: 1;
  text-align: center;
  color: var(--text-sub);
  font-size: 24rpx;
  padding: 8rpx 0;
}

.cal-row {
  display: flex;
}

.cal-cell {
  flex: 1;
  padding: 6rpx;
  box-sizing: border-box;
}

.cal-day {
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 26rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

.cal-day.blank {
  background: transparent;
}

.level-0 {
  background: #F5F5F5;
  color: var(--text-sub);
}

.level-1 {
  background: #FFE8D8;
  color: var(--primary);
  font-weight: 600;
}

.level-2 {
  background: #FFD3B5;
  color: #E8542A;
  font-weight: 700;
}

.level-3 {
  background: var(--primary);
  color: #FFFFFF;
  font-weight: 700;
}

.cal-day.today {
  border: 2rpx solid var(--primary);
}

.cal-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 20rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-left: 16rpx;
}

.legend-dot.l0 { background: #F5F5F5; }
.legend-dot.l1 { background: #FFE8D8; }
.legend-dot.l2 { background: #FFD3B5; }
.legend-dot.l3 { background: var(--primary); }

.legend-text {
  font-size: 22rpx;
  color: var(--text-sub);
}
