.confetti-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
}

.confetti-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.piece {
  position: absolute;
  top: -30rpx;
  border-radius: 4rpx;
  animation-name: confetti-fall;
  animation-timing-function: ease-in;
  animation-iteration-count: infinite;
}

.piece.shape-1 {
  border-radius: 50%;
}

.piece.shape-2 {
  border-radius: 0;
  transform: rotate(45deg);
}

@keyframes confetti-fall {
  0% {
    transform: translateY(0) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translateY(110vh) rotate(720deg);
    opacity: 0.6;
  }
}

.confetti-card {
  width: 560rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 60rpx 40rpx 48rpx;
  text-align: center;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.25);
  animation: pop-in 0.4s ease-out;
}

@keyframes pop-in {
  0% {
    transform: scale(0.6);
    opacity: 0;
  }
  100% {
    transform: scale(1);
    opacity: 1;
  }
}

.confetti-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.confetti-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--primary);
  margin-bottom: 16rpx;
}

.confetti-text {
  font-size: 28rpx;
  color: var(--text-sub);
  margin-bottom: 48rpx;
}

.confetti-btn {
  background: linear-gradient(135deg, #FF9A62, #FF6A3D);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
