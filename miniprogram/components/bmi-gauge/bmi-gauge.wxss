.bmi-gauge {
  width: 100%;
}

.gauge-canvas {
  width: 100%;
  aspect-ratio: 520 / 440;
  display: block;
  border-radius: 24rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8rpx 20rpx;
  margin-top: 4rpx;
  padding: 0 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.legend-text {
  font-size: 24rpx;
  color: #6b7a90;
  white-space: nowrap;
}
